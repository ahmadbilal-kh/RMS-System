# Local development values; production variables belong in the API host's secret settings.
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Optional DNS override if the system resolver refuses Atlas SRV lookups:
# MONGODB_DNS_SERVERS=1.1.1.1,1.0.0.1
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SAMESITE=lax
ADMIN_EMAILS=owner@seasoned.com
ADMIN_INITIAL_PASSWORD=

# Password reset via Resend. Use a sender address on a verified domain.
RESEND_API_KEY=
EMAIL_FROM="DineNova <noreply@your-verified-domain.com>"

# Optional Google OAuth. Add the callback URL to the Google OAuth client:
# http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
